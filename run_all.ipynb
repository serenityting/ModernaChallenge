import os
import sys
import subprocess
from pathlib import Path
PROJECT_ROOT = Path.cwd()
SRC = PROJECT_ROOT / "src"

print(PROJECT_ROOT)
print(SRC)
def run_script(script, args=None):
    if args is None:
        args = []

    script_path = SRC / script

    print("=" * 70)
    print(f"Running {script}")
    print("=" * 70)

    result = subprocess.run(
        [sys.executable, str(script_path)] + args,
        cwd=PROJECT_ROOT,
        text=True
    )

    if result.returncode != 0:
        print(f"X {script} failed")
        return False

    print(f"Yes {script} completed")
    return True
scripts = [
    "qubo_builder.py",
    "solvers.py",
    "metrics.py",
    "benchmark.py",
    "noise_robustness.py",
    "scaling_analysis.py",
    "make_plots.py",
    # "build_deck.js"  # JavaScript (run separately if Node.js is installed)
]
for script in scripts:
    success = run_script(script)

    if not success:
        print("Stopping execution.")
        break
